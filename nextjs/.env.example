# Copy to .env.local and fill in. Never commit .env.local.
# Get a free key (no credit card): https://nexwall.kodnextech.com/developers/register

# Server-side only. Do NOT prefix with NEXT_PUBLIC_ (that would ship it to the browser).
NEXWALL_API_KEY=your_key_here

# Optional, defaults to the public API.
# NEXWALL_BASE_URL=https://nexwall.kodnextech.com/api/developer/v1
